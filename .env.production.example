# =============================================================================
# GEO Tracker — Production environment configuration template
# =============================================================================
# Copy to .env.production and fill in real values.
# NEVER commit .env.production or any file with live secrets.
# All values shown here are placeholders — replace with real values.
# =============================================================================

# --- Application ---
APP_ENV=production
APP_NAME=GEO Tracker
APP_SECRET_KEY=<generate-a-64+char-random-string>
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# --- Build metadata (injected at build/deploy time) ---
APP_VERSION=0.1.0
GIT_SHA=
BUILD_TIME=

# --- Database (PostgreSQL) ---
# DATABASE_URL is constructed by docker-compose.prod.yml from the
# DATABASE_USER / DATABASE_PASSWORD / DATABASE_NAME values below.
# Do NOT define DATABASE_URL here — it causes Docker Compose
# unresolved-variable interpolation warnings.
DATABASE_USER=geo_tracker
DATABASE_PASSWORD=<strong-production-password>
DATABASE_NAME=geo_tracker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Redis ---
# Use the internal Docker network hostname 'redis' in production compose.
REDIS_URL=redis://redis:6379/0

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Security ---
# Comma-separated list of allowed CORS origins (empty = same-origin only)
CORS_ORIGINS=
# Comma-separated list of allowed Host headers (REQUIRED in production)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# Comma-separated list of trusted proxy IPs/CIDRs for X-Forwarded-For.
# Set to the Docker internal subnet that Nginx uses to reach the app.
# Default: 172.16.0.0/12 (Docker default bridge subnet).
FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Registration / closed beta ---
# Production default: if REGISTRATION_MODE is NOT explicitly set, it
# defaults to "closed" (fail-closed). Set explicitly to "open" to allow
# public registration.
REGISTRATION_MODE=closed

# --- Session / cookie ---
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# --- AI Providers ---
# Leave empty until the provider is needed. A missing provider key/model
# does NOT crash application startup — it only causes that provider's
# adapter to raise ProviderConfigurationError when requested.
OPENAI_API_KEY=
OPENAI_SCAN_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_SCAN_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_API_KEY=
GOOGLE_SCAN_MODEL=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
PERPLEXITY_API_KEY=
PERPLEXITY_SCAN_MODEL=
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# --- Provider HTTP settings ---
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_READ_TIMEOUT_SECONDS=120
PROVIDER_MAX_OUTPUT_TOKENS=4096

# --- Quota ---
QUOTA_RESERVATION_TTL_SECONDS=1800

# --- Scan engine / Celery ---
SCAN_MAX_CONCURRENCY=4
SCAN_RESERVATION_TTL_SECONDS=21600
SCAN_STALE_AFTER_SECONDS=7200
PRICING_REQUIRE_RULE_FOR_EXECUTION=true
CELERY_BROKER_URL=

# --- Dev only (MUST be false in production) ---
DEV_SEED_ENABLED=false

# --- Scheduler ---
SCHEDULER_SWEEP_INTERVAL_SECONDS=60

# --- Email / SMTP ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=noreply@your-domain.com
EMAIL_FROM_NAME=GEO Tracker
# MUST be HTTPS in production
APP_PUBLIC_BASE_URL=https://your-domain.com
EMAIL_STALE_SENDING_THRESHOLD_SECONDS=300
EMAIL_OUTBOX_SWEEP_INTERVAL_SECONDS=60
