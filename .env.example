# =============================================================================
# GEO Tracker — environment configuration template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=GEO Tracker
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://geo_tracker:geo_tracker_dev_password@localhost:5432/geo_tracker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security ---
# Comma-separated list of allowed CORS origins (empty = same-origin only)
CORS_ORIGINS=

# --- AI Providers (placeholders, not required for Phase 0/1) ---
# Leave empty until the provider integration phase.
OPENAI_API_KEY=
OPENAI_SCAN_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_SCAN_MODEL=
GOOGLE_API_KEY=
GOOGLE_SCAN_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_SCAN_MODEL=

# --- Billing integrations (placeholders, not required for Phase 0/1) ---
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Seed / dev only ---
# When true, the development seed script may run. NEVER true in production.
DEV_SEED_ENABLED=false
