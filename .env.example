# =============================================================================
# GEO Tracker — environment configuration template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=GEO Tracker
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://geo_tracker:geo_tracker_dev_password@localhost:5432/geo_tracker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security ---
# Comma-separated list of allowed CORS origins (empty = same-origin only)
CORS_ORIGINS=

# --- AI Providers ---
# Leave empty until the provider is needed. A missing provider key/model
# does NOT crash application startup — it only causes that provider's
# adapter to raise ProviderConfigurationError when requested.
OPENAI_API_KEY=
OPENAI_SCAN_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_SCAN_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_WEB_SEARCH_TOOL_VERSION=web_search_20250305
ANTHROPIC_WEB_SEARCH_MAX_USES=5
GOOGLE_API_KEY=
GOOGLE_SCAN_MODEL=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
PERPLEXITY_API_KEY=
PERPLEXITY_SCAN_MODEL=
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# --- Provider HTTP settings ---
# Timeouts for provider API calls (seconds). Must be positive.
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_READ_TIMEOUT_SECONDS=120
# Default max output tokens for provider responses.
PROVIDER_MAX_OUTPUT_TOKENS=4096

# --- Billing integrations (placeholders, not required for Phase 0/1) ---
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Quota ---
# TTL for AI Check quota reservations (seconds). Default: 1800 (30 minutes).
QUOTA_RESERVATION_TTL_SECONDS=1800

# --- Seed / dev only ---
# When true, the development seed script may run. NEVER true in production.
DEV_SEED_ENABLED=false
